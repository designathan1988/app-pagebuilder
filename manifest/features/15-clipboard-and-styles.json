{
  "group": "clipboard-and-styles",
  "titleKey": "featureGroup.clipboardAndStyles",
  "features": [
    {
      "id": "clipboard-cut-system",
      "titleKey": "feature.clipboardCutSystem",
      "commands": [
        "clipboard.cut"
      ],
      "dependsOn": [
        "clipboard-copy-paste",
        "export-bem-css"
      ],
      "spec": "spec/BEHAVIOUR.md#clipboard-cut-system",
      "intent": {
        "title": "Cut, and copy elements as HTML for other applications",
        "steps": [
          "Insert the Card template, select its root and press Ctrl+X.",
          "Select a Section and press Ctrl+V.",
          "Press Ctrl+C on the pasted Card and read the system clipboard's text/html."
        ],
        "expected": [
          "Ctrl+X copies the element to the system clipboard and deletes it as one undo step; Cut appears in the context menu and the Edit menu.",
          "Copy also writes text/html of the element's exported markup with its CSS rules, next to the app's element format.",
          "The clipboard text/html contains no editor attributes, editor-generated ids or inline styles."
        ]
      },
      "scenarios": [
        {
          "id": "cut-by-the-key-takes-the-heading-out-in-one-undo-step",
          "setup": {
            "fixture": "aurora",
            "selection": [
              "/Page/Hero/Title"
            ],
            "context": "global",
            "breakpoint": "desktop",
            "state": "base",
            "locale": "en",
            "viewport": "desktop-1440",
            "zoom": "fit"
          },
          "steps": [
            {
              "door": "clipboard.cut#key-ctrl-x-in-global",
              "args": {},
              "target": null,
              "drop": null,
              "action": true,
              "hold": false,
              "type": null
            }
          ],
          "doors": [
            "clipboard.cut#key-ctrl-x-in-global",
            "clipboard.cut#menu-edit",
            "clipboard.cut#command-bar"
          ],
          "expect": {
            "document": [
              {
                "op": "remove",
                "path": "/Page/Hero/Title"
              }
            ],
            "selection": [
              "/Page/Hero/Intro"
            ],
            "history": {
              "undoSteps": 1,
              "undoRestores": true,
              "redoRestores": true
            },
            "render": {
              "computed": [],
              "geometry": [],
              "feedback": [
                {
                  "key": "status.cut",
                  "params": {
                    "name": "Title"
                  }
                }
              ]
            },
            "editor": null,
            "persistence": null,
            "export": null
          },
          "refusals": []
        },
